# Server-side secrets. Never put real values in this file, in src/, or in git.
#
# Supabase Edge Functions read these from:
#   Supabase dashboard → Aurum project → Edge Functions → Secrets
#   (or: supabase secrets set NAME=value)
#
# Upstash Redis — console.upstash.com → your database → REST API
# Used by supabase/functions/_shared/redis.ts (price/chart cache, rate limits).
# Leave unset and the functions simply run without the cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Market data and email (already set in Supabase)
TWELVE_DATA_API_KEY=
RESEND_API_KEY=

# Provided automatically by Supabase inside edge functions — do not set
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
